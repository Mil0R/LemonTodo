{
  "name": "lemontodo-mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@noble/ciphers": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "base64-js": "^1.5.1",
    "expo": "~56.0.12",
    "expo-crypto": "^56.0.4",
    "expo-dev-client": "~56.0.20",
    "expo-file-system": "~56.0.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-argon2": "^4.0.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --dev-client",
    "expo-go": "expo start",
    "android": "JAVA_HOME=${JAVA_HOME:-$HOME/.local/share/jdks/temurin-17} ANDROID_HOME=${ANDROID_HOME:-$HOME/Android/Sdk} ANDROID_SDK_ROOT=${ANDROID_SDK_ROOT:-${ANDROID_HOME:-$HOME/Android/Sdk}} expo run:android",
    "build:android:preview": "npx eas-cli build --platform android --profile preview",
    "build:android:production": "npx eas-cli build --platform android --profile production",
    "build:ios:development": "npx eas-cli build --platform ios --profile development",
    "build:ios:preview": "npx eas-cli build --platform ios --profile preview",
    "build:ios:production": "npx eas-cli build --platform ios --profile production",
    "ios": "expo run:ios",
    "postinstall": "patch-package",
    "submit:android": "npx eas-cli submit --platform android --profile production",
    "submit:ios": "npx eas-cli submit --platform ios --profile production",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit"
  },
  "private": true
}
