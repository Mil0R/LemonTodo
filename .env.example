LEMONTODO_IMAGE=ghcr.io/mil0r/lemontodo:latest
LEMONTODO_PORT=8787
LEMONTODO_ALLOW_REGISTRATION=false
LEMONTODO_SESSION_TTL_SECS=2592000

# Optional first-admin bootstrap. Admin is only created when no matching admin exists.
# Prefer LEMONTODO_ADMIN_PASSWORD_FILE with Docker secrets in production.
LEMONTODO_ADMIN_EMAIL=
LEMONTODO_ADMIN_PASSWORD=
LEMONTODO_ADMIN_PASSWORD_FILE=
