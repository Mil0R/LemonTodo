{
  "name": "lemontodo-e2e",
  "version": "0.1.0",
  "description": "LemonTodo is a developer-first, local-first, end-to-end encrypted Todo application.",
  "private": true,
  "scripts": {
    "e2e:register": "playwright test tests/register-page.spec.mjs",
    "mobile:start": "npm --prefix apps/mobile run start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:web": "npm --prefix apps/mobile run web",
    "server:dev": "cargo run -p lemontodo-server",
    "server:dev:local": "LEMONTODO_SERVER_HOST=0.0.0.0 LEMONTODO_SERVER_PORT=8787 LEMONTODO_ALLOW_REGISTRATION=true LEMONTODO_CORS_ALLOW_ORIGIN=http://localhost:8082 cargo run -p lemontodo-server",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:preview": "npm --prefix apps/web run preview"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mil0R/LemonTodo.git"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-3.0-only OR AGPL-3.0-only",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Mil0R/LemonTodo/issues"
  },
  "homepage": "https://github.com/Mil0R/LemonTodo#readme",
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
